{
  // ═══════════════════════════════════════════════════════════
  // EDITOR — Core Behaviour
  // ═══════════════════════════════════════════════════════════
  "editor.fontFamily": "JetBrains Mono, 'Fira Code', 'Cascadia Code', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.fontWeight": "500",
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.3,

  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.trimAutoWhitespace": true,

  "editor.wordWrap": "on",
  "editor.wrappingIndent": "indent",
  "editor.wordWrapColumn": 120,

  "editor.minimap.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "editor.renderWhitespace": "selection",
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "all",
  "editor.cursorBlinking": "smooth",
  "editor.cursorStyle": "line",
  "editor.cursorSurroundingLines": 8,
  "editor.allowVariableFontsInAccessibilityMode": true,

  // ═══════════════════════════════════════════════════════════
  // EDITOR — Bracket & Guide Settings
  // ═══════════════════════════════════════════════════════════
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.guides.highlightActiveIndentation": true,
  "editor.matchBrackets": "always",
  "editor.linkedEditing": true,

  // ═══════════════════════════════════════════════════════════
  // EDITOR — IntelliSense & Suggestions
  // ═══════════════════════════════════════════════════════════
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.showToolbar": "onHover",
  "editor.suggest.showMethods": true,
  "editor.suggest.showFunctions": true,
  "editor.suggest.showConstructors": true,
  "editor.suggest.showFields": true,
  "editor.suggest.showVariables": true,
  "editor.suggest.showClasses": true,
  "editor.suggest.showInterfaces": true,
  "editor.suggest.showModules": true,
  "editor.suggest.showProperties": true,
  "editor.suggest.showEvents": true,
  "editor.suggest.showOperators": true,
  "editor.suggest.showKeywords": true,
  "editor.suggest.showWords": true,
  "editor.suggest.insertMode": "replace",
  "editor.suggest.localityBonus": true,
  "editor.suggest.shareSuggestSelections": false,
  "editor.parameterHints.enabled": true,
  "editor.parameterHints.cycle": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on",
  },
  "editor.acceptSuggestionOnEnter": "smart",

  // ═══════════════════════════════════════════════════════════
  // EDITOR — Format & Code Actions on Save
  // ═══════════════════════════════════════════════════════════
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnType": true,
  "editor.formatOnPaste": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "never",
  },

  // ═══════════════════════════════════════════════════════════
  // EDITOR — Multi-cursor & Selection
  // ═══════════════════════════════════════════════════════════
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.columnSelection": false,
  "editor.selectionHighlight": true,
  "editor.occurrencesHighlight": "singleFile",
  "editor.findMatchHighlightLimit": 300,

  // ═══════════════════════════════════════════════════════════
  // WORKBENCH — Theme & Icons
  // ═══════════════════════════════════════════════════════════
  "workbench.preferredHighContrastColorTheme": "Monokai",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 20,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.list.smoothScrolling": true,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.docx": "default",
  },
  "workbench.settings.applyToAllProfiles": [
    "terminal.integrated.fontFamily",
    "editor.fontFamily",
    "chat.sessionSync.enabled",
    "github.copilot.chat.localIndex.enabled",
  ],
  "workbench.experimental.share.enabled": true,

  // ═══════════════════════════════════════════════════════════
  // WORKBENCH — Layout & Panels
  // ═══════════════════════════════════════════════════════════
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.colorCustomizations": {},

  // ═══════════════════════════════════════════════════════════
  // TERMINAL
  // ═══════════════════════════════════════════════════════════
  "terminal.integrated.fontFamily": "JetBrains Mono, 'MesloLGS NF', 'FiraCode Nerd Font', monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "400",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontLigatures.fallbackLigatures": [
    "<--",
    "<---",
    "<<-",
    "<-",
    "->",
    "->>",
    "-->",
    "--->",
    "<==",
    "<===",
    "<<=",
    "<=",
    "=>",
    "=>>",
    "==>",
    "===>",
    ">=",
    ">>=",
    "<->",
    "<-->",
    "<--->",
    "<---->",
    "<=>",
    "<==>",
    "<===>",
    "<====>",
    "::",
    ":::",
    "<~~",
    "</",
    "</>",
    "/>",
    "~~>",
    "==",
    "!=",
    "/=",
    "~=",
    "<>",
    "===",
    "!==",
    "!===",
    "<:",
    ":=",
    "*=",
    "*+",
    "<*",
    "<*>",
    "*>",
    "<|",
    "<|>",
    "|>",
    "+*",
    "=*",
    "=:",
    ":>",
    "/*",
    "*/",
    "+++",
    "<!--",
    "<!---",
  ],
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1",
  },

  // ═══════════════════════════════════════════════════════════
  // GIT
  // ═══════════════════════════════════════════════════════════
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "never",
  "git.branchProtection": ["main", "master", "production"],
  "git.mergeEditor": true,
  "diffEditor.renderSideBySide": false,
  "diffEditor.ignoreTrimWhitespace": true,

  // ═══════════════════════════════════════════════════════════
  // GITHUB COPILOT / CHAT
  // ═══════════════════════════════════════════════════════════
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "plaintext": false,
    "scminput": false,
    "dotenv": true,
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.nextEditSuggestions.eagerness": "high",
  "github.copilot.chat.localIndex.enabled": false,
  "chat.agent.maxRequests": 250,
  "chat.editing.confirmEditRequestRemoval": false,
  "chat.editing.confirmEditRequestRetry": false,
  "chat.viewSessions.orientation": "stacked",
  "chat.agent.sandbox.enabled": "on",
  "chat.agentHost.sdkSandbox.enabled": "on",
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true,
    "windsurf": true,
    "cursor-workspace": true,
    "cursor-global": true,
  },
  "js/ts.experimental.useTsgo": false,

  // ═══════════════════════════════════════════════════════════
  // CLAUDE CODE
  // ═══════════════════════════════════════════════════════════
  "claudeCode.preferredLocation": "panel",

  // ═══════════════════════════════════════════════════════════
  // EXPLORER
  // ═══════════════════════════════════════════════════════════
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.sortOrder": "type",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.js.map",
    "*.tsx": "${capture}.module.css, ${capture}.module.scss",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc, .nvmrc",
    "tsconfig.json": "tsconfig.*.json",
    ".eslintrc.*": ".eslintignore, .prettierrc*, .stylelintrc*",
    "Dockerfile": "docker-compose*.yml, docker-compose*.yaml, .dockerignore",
    "*.env": "*.env.*",
    "pyproject.toml": "setup.py, setup.cfg, MANIFEST.in, requirements*.txt, .python-version",
    "manifest.json": "manifest.*.json",
  },

  // ═══════════════════════════════════════════════════════════
  // FILES
  // ═══════════════════════════════════════════════════════════
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.associations": {
    "*.jinja": "jinja",
    "*.j2": "jinja",
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.venv": false,
    "**/dist": false,
    "**/.next": false,
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true,
    "**/.next": true,
    "**/build": true,
  },

  // ═══════════════════════════════════════════════════════════
  // NOTEBOOKS (Jupyter)
  // ═══════════════════════════════════════════════════════════
  "notebook.formatOnSave.enabled": true,
  "notebook.lineNumbers": "on",
  "notebook.output.scrolling": true,
  "notebook.output.textLineLimit": 50,
  "notebook.scrolling.revealNextCellOnExecute": "none",
  "notebook.cellToolbarLocation": { "default": "right" },
  "notebook.compactView": true,

  // ═══════════════════════════════════════════════════════════
  // LANGUAGE-SPECIFIC SETTINGS
  // ═══════════════════════════════════════════════════════════

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
    "editor.rulers": [88],
    "editor.tabSize": 4,
  },
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.indexing": true,

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.eslint": "explicit",
    },
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.eslint": "explicit",
    },
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.returnTypes.enabled": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.suggest.autoImports": true,
  "javascript.suggest.autoImports": true,

  // Tailwind CSS v4 — pick up class-list props in cva()/clsx()/cn() helpers
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["clsx\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
  ],

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
  },
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://openapi.vercel.sh": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true,
  },

  "[markdown]": {
    "editor.defaultFormatter": "davidanson.vscode-markdownlint",
    "editor.formatOnSave": false,
    "editor.quickSuggestions": {
      "comments": "on",
      "other": "on",
      "strings": "on",
    },
    "editor.wordWrap": "on",
  },

  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
  },
  "[plaintext]": {
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off",
    },
  },

  // ═══════════════════════════════════════════════════════════
  // EXTENSIONS — GitLens (AI backend: GitKraken, matches the GitKraken MCP wired up 2026-08-21)
  // ═══════════════════════════════════════════════════════════
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "gitlens.ai.gitkraken.model": "openai:gpt-5-mini",
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.codeLens.enabled": false,

  // ═══════════════════════════════════════════════════════════
  // EXTENSIONS — Kubernetes / Docker
  // ═══════════════════════════════════════════════════════════
  "vs-kubernetes": {
    "vscode-kubernetes.helm-path-linux": "/home/kneeraazon/.local/state/vs-kubernetes/tools/helm/linux-amd64/helm",
    "vscode-kubernetes.kubectl-path-linux": "/home/kneeraazon/.local/state/vs-kubernetes/tools/kubectl/kubectl",
    "vscode-kubernetes.minikube-path-linux": "/home/kneeraazon/.local/state/vs-kubernetes/tools/minikube/linux-amd64/minikube",
  },

  // ═══════════════════════════════════════════════════════════
  // EXTENSIONS — MongoDB
  // ═══════════════════════════════════════════════════════════
  "mdb.mcp.server": "prompt",

  // ═══════════════════════════════════════════════════════════
  // EXTENSIONS — Project Manager
  // ═══════════════════════════════════════════════════════════
  "projectManager.git.baseFolders": [""],

  // ═══════════════════════════════════════════════════════════
  // EXTENSIONS — Misc
  // ═══════════════════════════════════════════════════════════
  "vsicons.dontShowNewVersionMessage": true,
  "redhat.telemetry.enabled": true,
  "markdown-preview-enhanced.previewTheme": "monokai.css",
  "screencastMode.fontSize": 30,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],

  // ═══════════════════════════════════════════════════════════
  // SECURITY
  // ═══════════════════════════════════════════════════════════
  "security.workspace.trust.untrustedFiles": "open",

  // ═══════════════════════════════════════════════════════════
  // ZEN MODE
  // ═══════════════════════════════════════════════════════════
  "zenMode.centerLayout": false,
  "zenMode.fullScreen": false,
  "zenMode.hideLineNumbers": false,

  // ═══════════════════════════════════════════════════════════
  // DEBUG
  // ═══════════════════════════════════════════════════════════
  "debug.console.fontFamily": "JetBrains Mono",
  "debug.console.fontSize": 12,
  "debug.inlineValues": "on",
  "debug.showBreakpointsInOverviewRuler": true,

  // ═══════════════════════════════════════════════════════════
  // WINDOW
  // ═══════════════════════════════════════════════════════════
  "window.confirmSaveUntitledWorkspace": false,
  "window.newWindowProfile": "Default",
  "window.title": "${activeEditorShort}${separator}${rootName}",
  "window.titleBarStyle": "custom",
}
