{
    "show_signature_help_after_edits": true,
    "auto_signature_help": true,
    "multi_cursor_modifier": "cmd_or_ctrl",
    "vertical_scroll_margin": 8.0,
    "selection_highlight": true,
    "window_title_format": "${fileName}${separator}${projectName}",
    "buffer_font_fallbacks": [
        "Fira Code",
        "Cascadia Code",
        "Consolas",
        "monospace"
    ],
    "file_scan_exclusions": [
        "**/.git",
        "**/.DS_Store",
        "**/node_modules",
        "**/__pycache__",
        "**/*.pyc",
        "..."
    ],
    "colorize_brackets": true,
    "completions": {
        "words": "enabled"
    },
    "auto_indent_on_paste": false,
    "use_on_type_format": true,
    "show_edit_predictions": true,
    "line_ending": "prefer_lf",
    "soft_wrap_indent": "extra_one",
    "proxy": "",
    "title_bar": {
        "show_menus": false,
        "show_branch_status_icon": true,
    },
    "agent_buffer_font_size": 14.0,
    "rounded_selection": true,
    "show_wrap_guides": true,
    "ui_font_weight": 500.0,
    "ui_font_family": "DejaVu Sans",
    "buffer_line_height": {
        "custom": 1.2,
    },
    "redact_private_values": true,
    "edit_predictions": {
        "provider": "ollama",
    },
    "agent_servers": {
        "codex-acp": {
            "type": "registry"
        },
        "claude-acp": {
            "type": "registry"
        },
        "opencode": {
            "type": "registry"
        },
    },
    "context_servers": {
        "mcp-server-brave-search": {
            "enabled": true,
            "remote": false,
            "settings": {},
        },
        "browser-tools-context-server": {
            "enabled": true,
            "remote": false,
            "settings": {},
        },
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "agent": {
        "tool_permissions": {
            "tools": {
                "create_directory": {
                    "default": "deny",
                },
            },
        },
        "dock": "right",
        "default_model": {
            "provider": "ollama",
            "model": "deepseek-v4-flash:cloud",
            "enable_thinking": true,
        },
        "favorite_models": [],
        "model_parameters": [],
    },
    "base_keymap": "VSCode",
    "theme": "VSCode Dark Modern",
    "icon_theme": "Material Icon Theme",
    "buffer_font_family": "JetBrains Mono",
    "buffer_font_size": 14,
    "buffer_font_weight": 500.0,
    "buffer_font_features": {
        "calt": true,
        "liga": true,
    },
    "ui_font_size": 16.0,
    "cursor_shape": "bar",
    "cursor_blink": true,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "format_on_save": "on",
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "preferred_line_length": 120,
    "soft_wrap": "editor_width",
    "linked_edits": true,
    "tab_size": 2,
    "hard_tabs": false,
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware",
        "background_coloring": "indent_aware",
    },
    "show_whitespaces": "selection",
    "current_line_highlight": "all",
    "scrollbar": {
        "show": "auto",
        "cursors": true,
        "git_diff": true,
        "search_results": true,
        "selected_symbol": true,
        "diagnostics": "all",
    },
    "minimap": {
        "show": "never",
    },
    "preview_tabs": {
        "enabled": true,
        "enable_preview_from_file_finder": false,
        "enable_keep_preview_on_code_navigation": false,
    },
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
    },
    "show_completions_on_input": true,
    "show_completion_documentation": true,
    "semantic_tokens": "combined",
    "file_types": {
        "Dockerfile": ["Dockerfile*", "*.dockerfile"],
        "Docker Compose": ["docker-compose*.yml", "docker-compose*.yaml"],
        "Jinja": ["*.jinja", "*.jinja2", "*.j2"],
    },
    // Only what differs from the top-level defaults above lives here, except
    // Markdown, which stays self-contained: Zed's built-in per-language defaults
    // take precedence over global settings.
    "languages": {
        "Python": {
            // Ruff formats with its own 4-space indent width.
            "tab_size": 4,
            "formatter": [
                {
                    "code_action": "source.organizeImports.ruff",
                },
                {
                    "code_action": "source.fixAll.ruff",
                },
                {
                    "language_server": {
                        "name": "ruff",
                    },
                },
            ],
            "language_servers": ["pyright", "ruff", "!basedpyright", "!rope", "..."],
        },
        "JavaScript": {
            "formatter": [
                {
                    "code_action": "source.fixAll.eslint",
                },
                {
                    "external": {
                        "command": "prettier",
                        "arguments": ["--stdin-filepath", "{buffer_path}"],
                    },
                },
            ],
            "language_servers": ["typescript-language-server", "eslint", "!vtsls", "..."],
        },
        "TypeScript": {
            "formatter": [
                {
                    "code_action": "source.fixAll.eslint",
                },
                {
                    "external": {
                        "command": "prettier",
                        "arguments": ["--stdin-filepath", "{buffer_path}"],
                    },
                },
            ],
            "language_servers": ["typescript-language-server", "eslint", "!vtsls", "..."],
        },
        "TSX": {
            "formatter": [
                {
                    "code_action": "source.fixAll.eslint",
                },
                {
                    "external": {
                        "command": "prettier",
                        "arguments": ["--stdin-filepath", "{buffer_path}"],
                    },
                },
            ],
            "language_servers": [
                "typescript-language-server",
                "eslint",
                "tailwindcss-language-server",
                "!vtsls",
                "...",
            ],
        },
        "JSX": {
            "formatter": [
                {
                    "code_action": "source.fixAll.eslint",
                },
                {
                    "external": {
                        "command": "prettier",
                        "arguments": ["--stdin-filepath", "{buffer_path}"],
                    },
                },
            ],
            "language_servers": [
                "typescript-language-server",
                "eslint",
                "tailwindcss-language-server",
                "!vtsls",
                "...",
            ],
        },
        "Dockerfile": {
            "enable_language_server": true,
        },
        "JSON": {
            "formatter": "language_server",
        },
        "YAML": {
            "formatter": "language_server",
        },
        "Markdown": {
            "colorize_brackets": true,
            "completions": {
                "words": "enabled"
            },
            "auto_indent_on_paste": false,
            "linked_edits": true,
            "use_on_type_format": true,
            "show_whitespaces": "selection",
            "show_edit_predictions": true,
            "line_ending": "prefer_lf",
            "ensure_final_newline_on_save": true,
            "remove_trailing_whitespace_on_save": true,
            "format_on_save": "on",
            "preferred_line_length": 120,
            "soft_wrap_indent": "extra_one",
            "hard_tabs": false,
            "tab_size": 2,
            "soft_wrap": "editor_width",
            "show_completions_on_input": true,
        },
    },
    "terminal": {
        "font_fallbacks": [
            "MesloLGS NF",
            "FiraCode Nerd Font",
            "monospace"
        ],
        "shell": "system",
        "font_family": "JetBrains Mono",
        "font_size": 14,
        "font_features": {
            "calt": true,
            "liga": true,
        },
        "blinking": "on",
        "cursor_shape": "bar",
        "copy_on_select": true,
        "option_as_meta": false,
        "max_scroll_history_lines": 10000,
    },
    "git": {
        "inline_blame": {
            "enabled": true,
        },
    },
    "telemetry": {
        "metrics": false,
        "diagnostics": false,
    },
    "project_panel": {
        "git_status_indicator": true,
        "bold_folder_labels": false,
        "entry_spacing": "standard",
        "dock": "left",
        "auto_fold_dirs": true,
        "auto_reveal_entries": true,
        "hide_gitignore": false,
        "git_status": true,
        "indent_size": 20,
    },
    "tab_bar": {
        "show": true,
        "show_tab_bar_buttons": true,
    },
    "tabs": {
        "git_status": true,
        "file_icons": true,
        "close_position": "right",
        "show_close_button": "always",
        "activate_on_close": "neighbour",
    },
    "status_bar": {
        "line_endings_button": false,
        "active_encoding_button": "enabled",
    },
}
