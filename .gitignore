# Editor/IDE state, not dotfiles content.
.idea/

# Local-only update logs (not pushed to remote)
UPDATES.md

# Local-only reference docs (cheatsheets, guides, roadmaps)
references/

# Exception: frontend-master's references/ is the skill's actual body, not a
# disposable cheatsheet — SKILL.md reads every file under it by path.
!05-ai/claude-code/skills/frontend-master/references/
!05-ai/claude-code/skills/frontend-master/references/**

# ── Machine-written / runtime state (added with install.sh) ──────────────────
# Regenerated by shipwright.nvim to mirror Neovim's colorscheme. kitty.conf
# includes it last so it wins; tracking it would fight the generator.
03-terminal/kitty/current-theme.conf

# Backups install.sh or kit migrations write before replacing a file.
*.bak-*
*.pre-*

# Local session/plugin state, never shared.
.remember/

# Local scratch area for the Ollama benchmark runs. Holds raw logs, transcripts,
# model blobs and a claude.json backup with credentials — never committed.
/ollama-setup/

# Claude Desktop's import-memory sync target — regenerated content, not authored
05-ai/claude-code/skills/synced/

__pycache__/
*.pyc
