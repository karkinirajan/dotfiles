[Unit]
Description=Persistent SSH master connection to the ERKE Nepal VPS
After=network-online.target

[Service]
# Clear a stale ControlMaster socket before opening a new connection, via the
# ssh_config alias rather than a hardcoded host/IP/port.
ExecStartPre=/bin/sh -c 'ssh -O exit sheesh-vps 2>/dev/null; true'
ExecStart=/usr/bin/ssh -N -o ControlMaster=yes -o ControlPersist=no -o ExitOnForwardFailure=yes sheesh-vps
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
