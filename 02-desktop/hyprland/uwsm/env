export BROWSER=brave
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto
export HYPRCURSOR_THEME="Bibata-Modern-Ice"
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=24

# User-installed command-line tools and Node.js must be visible to apps
# launched by the Wayland session (including Zed language servers).
export PATH="$HOME/.local/bin:$HOME/.local/share/pnpm:$PATH"
export NVM_DIR="$HOME/.config/nvm"
[ -s /usr/share/nvm/init-nvm.sh ] && . /usr/share/nvm/init-nvm.sh
nvm use default --silent >/dev/null 2>&1 || true

# If you have an NVIDIA GPU uncommment the following lines
