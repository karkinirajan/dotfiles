# Package the vendor's official .deb with its bundled Electron runtime.
# This avoids compiling AUR/electron36's full Chromium source tree.
pkgname=upwork
pkgver=5.8.0.41
pkgrel=6
pkgdesc='Official Upwork Desktop App for Linux'
arch=('x86_64')
url='https://www.upwork.com/ab/downloads/?os=linux'
license=('LicenseRef-Upwork-EULA')
# libappindicator replaces the old libappindicator-gtk3 name (still satisfied via provides).
# The deb's control Depends could not be read; run namcap on the built package for the rest.
depends=('libxcrypt-compat' 'libxss' 'libappindicator')
makedepends=('binutils' 'libarchive')
source=(
  "https://upwork-usw2-desktopapp.upwork.com/binaries/v5_8_0_41_f0de03505cc349f2/upwork_${pkgver}_amd64.deb"
  'upwork-license.pdf::https://upwork.pactsafe.io/versions/6887e5128f84f23a737bf6bb.pdf'
)
sha256sums=(
  'b2ed1ff34cfcc09cfa9ff472e39443aa999dd773867a57aef6f50798fb257239'
  '1d2db24cd1364f79d11b8683c15274f4e5c7ed9a3e46a5938b55c6e9ca56937f'
)
noextract=("upwork_${pkgver}_amd64.deb")
options=(!debug !strip)

prepare() {
  mkdir -p "$srcdir/extract"
  cd "$srcdir/extract" || return 1
  ar x "$srcdir/upwork_${pkgver}_amd64.deb"
  bsdtar -xf data.tar.xz
}

package() {
  install -d "$pkgdir/opt" "$pkgdir/usr/share"
  cp -dr --no-preserve=ownership "$srcdir/extract/opt/Upwork" "$pkgdir/opt/"
  cp -dr --no-preserve=ownership "$srcdir/extract/usr/share/applications" "$pkgdir/usr/share/"
  cp -dr --no-preserve=ownership "$srcdir/extract/usr/share/icons" "$pkgdir/usr/share/"
  install -Dm644 "$srcdir/upwork-license.pdf" \
    "$pkgdir/usr/share/licenses/upwork/upwork-license.pdf"
}
