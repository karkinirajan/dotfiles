#!/usr/sbin/nft -f
# Focus firewall table and IP sets (/etc/nftables.d/focus-filter.nft)
# Provides the inet focus sets populated by focus-refresh.
#
# Idempotent: loading this file repeatedly leaves exactly one copy of each
# rule and keeps the contents of the sets. nft -f appends rules, so the chain is
# flushed before the rules are declared. The table is named "focus" so it never
# collides with a generic "filter" table from another tool or a distro ruleset.

table inet focus {
    set allowed_ips {
        type ipv4_addr
        flags interval
    }

    set blocked_ips {
        type ipv4_addr
        flags interval
    }

    set allowed_ips6 {
        type ipv6_addr
        flags interval
    }

    set blocked_ips6 {
        type ipv6_addr
        flags interval
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}

flush chain inet focus output

table inet focus {
    chain output {
        ip daddr 127.0.0.0/8 accept
        ip6 daddr ::1 accept
        ip daddr @allowed_ips accept
        ip6 daddr @allowed_ips6 accept
        ip daddr @blocked_ips reject with icmpx type admin-prohibited
        ip6 daddr @blocked_ips6 reject with icmpx type admin-prohibited
    }
}
