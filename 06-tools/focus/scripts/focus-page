#!/usr/bin/env python3
"""Focus block page server — listens on 127.0.0.1 and ::1, port 80 (or FOCUS_PAGE_PORT)"""

import http.server, os, socket, socketserver, threading, urllib.parse
from datetime import datetime

# CSS braces doubled to escape Python str.format()
HTML = """<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>Focus Mode</title>
  <style>
    *{{margin:0;padding:0;box-sizing:border-box}}
    body{{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
          background:#0f0f0f;color:#e0e0e0;display:flex;
          align-items:center;justify-content:center;min-height:100vh}}
    .card{{text-align:center;max-width:480px;padding:3rem 2rem}}
    .icon{{font-size:4rem;margin-bottom:1.5rem}}
    h1{{font-size:1.8rem;font-weight:700;margin-bottom:.75rem;color:#fff}}
    .domain{{font-size:1rem;color:#888;background:#1a1a1a;border:1px solid #333;
             border-radius:6px;padding:.4rem 1rem;display:inline-block;
             margin:.75rem 0 1.5rem;font-family:monospace}}
    p{{color:#666;line-height:1.6;font-size:.95rem}}
    .time{{margin-top:2rem;font-size:.8rem;color:#444}}
  </style>
</head>
<body>
  <div class="card">
    <div class="icon">&#128683;</div>
    <h1>You're in focus mode</h1>
    <div class="domain">{host}</div>
    <p>This site is blocked to help you stay focused.<br>
       Disable focus mode when you're done working.</p>
    <div class="time">{time}</div>
  </div>
</body>
</html>"""

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        host = self.headers.get('Host', 'this site').split(':')[0]
        body = HTML.format(
            host=urllib.parse.quote(host, safe='.-'),
            time=datetime.now().strftime('%A, %H:%M')
        ).encode()
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.send_header('Content-Length', len(body))
        self.end_headers()
        self.wfile.write(body)
    def do_HEAD(self):
        self.send_response(200)
        self.send_header('Content-Type', 'text/html')
        self.end_headers()
    def log_message(self, *a): pass

class V6Server(socketserver.TCPServer):
    address_family = socket.AF_INET6

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
        super().server_bind()


def bind(cls, addr, port):
    return cls((addr, port), Handler)


if __name__ == '__main__':
    socketserver.TCPServer.allow_reuse_address = True
    preferred_port = int(os.environ.get('FOCUS_PAGE_PORT', '80'))

    def bind_all(port):
        # dnsmasq answers blocked names with both 127.0.0.1 and ::1, so serve both
        servers = [bind(socketserver.TCPServer, '127.0.0.1', port)]
        try:
            servers.append(bind(V6Server, '::1', port))
        except OSError as e:
            print(f'[focus-page] ::1 unavailable ({e}); IPv4 only', flush=True)
        return servers

    try:
        servers = bind_all(preferred_port)
        bound_port = preferred_port
    except OSError as e:
        # PermissionError without CAP_NET_BIND_SERVICE, EADDRINUSE when nginx holds :80
        print(f'[focus-page] port {preferred_port} unavailable ({e}); using 8080', flush=True)
        servers = bind_all(8080)
        bound_port = 8080
    for extra in servers[1:]:
        threading.Thread(target=extra.serve_forever, daemon=True).start()
    print(f'[focus-page] listening on {bound_port} '
          f'({", ".join(s.server_address[0] for s in servers)})', flush=True)
    with servers[0]:
        servers[0].serve_forever()
